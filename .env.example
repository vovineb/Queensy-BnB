# ---------------------------------------------------------------------------
# Queensy BnB environment configuration.
# Copy to `.env` for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL of the site (used for canonical URLs, sitemap, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. DATABASE_URL may be pooled; DIRECT_DATABASE_URL must be a direct
# connection (used for migrations and realtime LISTEN/NOTIFY).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/queensy
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/queensy

# Random 32+ byte secret used to sign anonymous analytics ids and cron requests.
# Generate with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too

# Email (password reset, booking notifications). Any SMTP provider works.
# If unset, emails are written to the server log (development only).
SMTP_URL=
EMAIL_FROM="Queensy BnB <no-reply@example.com>"

# Media storage: "local" (development, writes to ./uploads) or "s3"
# (any S3-compatible store: Supabase Storage, Cloudflare R2, AWS S3...).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves objects from the bucket (CDN or bucket URL).
S3_PUBLIC_URL=

# Defaults used when a property does not specify its own values.
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi

# One-time bootstrap of the first admin during `npm run db:seed` (or use
# `npm run admin:create -- --email you@example.com`). Remove after use.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
